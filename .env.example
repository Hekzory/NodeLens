# --- Postgres ---
POSTGRES_USER=nodelens
POSTGRES_PASSWORD=nodelens
POSTGRES_DB=nodelens
DATABASE_URL=postgresql+asyncpg://nodelens:nodelens@postgres:5432/nodelens

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- General ---
LOG_LEVEL=INFO

# --- Telemetry storage policies (read by ingestor + /api/health/storage) ---
# Drop telemetry chunks older than this. Diploma NF-6 = 365 days.
RETENTION_DAYS=365
# Compress chunks older than this (must be < RETENTION_DAYS).
COMPRESSION_AFTER_DAYS=7
# Hard upper bound on telemetry on-disk size. Diploma NF-7 = 30 GB.
DISK_BUDGET_GB=30
# How often the ingestor checks the disk budget.
RETENTION_CHECK_INTERVAL_SECONDS=3600
